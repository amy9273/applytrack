# Database URL for Prisma (SQLite for local, or PostgreSQL / Neon / Supabase on Vercel)
DATABASE_URL="file:./dev.db"

# Master Owner PIN to unlock Owner Mode and your real inboxes on deployed sites
# Visitors without this PIN will only see the sanitized dummy portfolio database
OWNER_PIN="applytrack2026"

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Optional Gemini API Key for AI Extraction (has rule-based fallback if not set)
GEMINI_API_KEY=""

# Application Host URL (e.g. http://localhost:3000 or https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
